# Solo para la SPA de React. Este fichero lo lee Vite ANTES de compilar, y su
# contenido queda escrito dentro del bundle: no es un runtime config.
#
# En produccion no hace falta crearlo. docker-compose.yml pasa
# VITE_API_BASE_URL como --build-arg al Dockerfile, asi que el valor por defecto
# de este fichero solo se aplica cuando se compila a mano con npm run build.
#
# VITE_API_BASE_URL=/api

# La SPA se sirve desde el mismo dominio que la API, asi que la ruta relativa
# "/api" basta. Con esta configuracion no hay CORS ni peticiones entre
# dominios distintos, y las cookies del panel no cruzan subdominios.
