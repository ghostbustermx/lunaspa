# Copiar a .env en el VPS y rellenar. NO versionar el .env resultante:
#
#   cp .env.example .env
#
# Este fichero es la unica fuente de secretos del despliegue. El contenedor no
# lee ningun .env de CodeIgniter: todo entra por docker-compose con el formato
# de variables de la seccion "environment" del compose.

# Dominio publico, con https:// y CON barra final. Es el valor mas importante
# de esta lista: en Nginx Proxy Manager se pone la misma cadena, y
# app.baseURL la concatena sin normalizar, asi que sin la barra final las
# redirecciones salen como https://ejemplo.comdashboard/.
APP_URL=https://sayulitamassagebyluna.com/

# Prefijo de la URL de la API que se compila en el bundle de la SPA.
# Con todo en un solo dominio se deja la ruta relativa: es lo que hace que no
# haya ni CORS ni URLs distintas entre desarrollo y produccion.
# Cambiarlo exige reconstruir la imagen (docker compose up -d --build).
VITE_API_BASE_URL=/api

# --------------------------------------------------------------- MySQL 8.0
# Generar contrasenas longues. Si se cambia MYSQL_PASSWORD despues de la
# primera vez, hay que actualizarlo tambien dentro de la base:
#
#   docker compose exec db mysql -ulunaspa -p'vieja' \
#     -e "ALTER USER 'lunaspa'@'%' IDENTIFIED BY 'nueva';"
#   docker compose up -d
#
# MYSQL_ROOT_PASSWORD solo se usa dentro del contenedor; no hace falta
# recordarlo para nada mas.
MYSQL_ROOT_PASSWORD=cambia_esta_raiz_por_una_larga
MYSQL_DATABASE=lunaspa
MYSQL_USER=lunaspa
MYSQL_PASSWORD=cambia_esta_por_una_larga

# --------------------------------------------------------------- Correo
# NECESARIAS para el formulario "View & Book" del sitio: el backend envia dos
# correos con la reserva (uno al equipo y una constancia al cliente y al
# webmaster). Sin SMTP_HOST la peticion cae a mail() del contenedor, que no
# esta configurado, y el envio devuelve error amigable.
#
# Gmail con App Password (OAuth/token no soportado por CodeIgniter 4):
#   - SMTP_USER debe ser la CUENTA que genero la app password. Google ata cada
#     app password a la cuenta que la crea; si se pone otra (p.ej. el alias
#     "Enviar como"), la autenticacion falla con 535.
#   - SMTP_PASS es la app password de 16 caracteres. Puede llevar espacios
#     (p.ej. "rdrj rory uodh eltg"): en docker-compose entra por variable de
#     entorno, no por el parseo del .env, asi que no necesita comillas.
#   - El correo de la constancia sale con From = SMTP_USER para pasar SPF/DKIM
#     de gmail.com y no caer en spam en el buzón de otros proveedores.
# Se mantienen fuera del repositorio, como el resto de secretos.
SMTP_HOST=smtp.gmail.com
SMTP_USER=keconecte@gmail.com
SMTP_PASS=
SMTP_PORT=587
SMTP_CRYPTO=tls
SMTP_AUTH_METHOD=login
SMTP_TIMEOUT=10
